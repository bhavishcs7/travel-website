# =================================================================
# BACKEND ENVIRONMENT VARIABLES (Render Web Service)
# =================================================================
# MongoDB Atlas Database Connection String (Required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/content_hunter?retryWrites=true&w=majority

# Port and Environment
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (e.g. https://contenthunter.onrender.com)
CLIENT_URL=https://your-frontend-app.onrender.com

# JWT Authentication Secret (Required in production)
JWT_SECRET=generate_a_secure_random_string_for_jwt_production

# Initial Admin Credentials (Created if no admin exists)
ADMIN_EMAIL=admin@contenthunter.com
ADMIN_PASSWORD=SetAStrongPasswordHere123!
ADMIN_NAME=Content Hunter Admin

# Cloudinary Image Hosting (Required for persistent image & gallery uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =================================================================
# FRONTEND ENVIRONMENT VARIABLES (Render Static Site / Vite)
# =================================================================
# Backend API Base URL (Must point to your Render backend web service)
VITE_API_URL=https://your-backend-app.onrender.com/api
