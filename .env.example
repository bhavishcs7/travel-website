# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/content_hunter?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Admin Credentials
ADMIN_EMAIL=admin@contenthunter.com
ADMIN_PASSWORD=AdminPassword123!

# Cloudinary Image Hosting (Required for image uploads on Vercel)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
